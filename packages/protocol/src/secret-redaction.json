{
  "redacted": "[REDACTED]",
  "inlinePatterns": [
    {
      "id": "anthropic-key",
      "pattern": "\\bsk-ant-[a-zA-Z0-9_\\-]{20,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "openai-key",
      "pattern": "\\bsk-[a-zA-Z0-9_\\-]{20,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "google-api-key",
      "pattern": "\\bAIzaSy[a-zA-Z0-9_\\-]{33}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "github-fine-grained-pat",
      "pattern": "\\bgithub_pat_[a-zA-Z0-9_]{20,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "github-classic-pat",
      "pattern": "\\bghp_[a-zA-Z0-9]{20,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "github-oauth-token",
      "pattern": "\\bgho_[a-zA-Z0-9]{20,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "slack-token",
      "pattern": "\\bxox[aboprs]-[a-zA-Z0-9-]{10,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "google-access-token",
      "pattern": "\\bya29\\.[a-zA-Z0-9._\\-]{10,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "google-refresh-token",
      "pattern": "\\b1//[0-9A-Za-z_-]{8,}\\b",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "pem-private-key",
      "pattern": "-----BEGIN [A-Z ]{0,64}PRIVATE KEY-----[\\s\\S]{0,16384}?-----END [A-Z ]{0,64}PRIVATE KEY-----",
      "flags": "g",
      "replacement": "[REDACTED]"
    },
    {
      "id": "bearer-token",
      "pattern": "\\bBearer\\s+[a-zA-Z0-9\\-._~+/]{10,}(?:=*)?\\b",
      "flags": "gi",
      "replacement": "Bearer [REDACTED]"
    },
    {
      "id": "secret-assignment",
      "pattern": "(\\b(?:api[-_]?key|x-api-key|token|password|passwd|cookie|authorization|secret|credential|session[-_]?token|access[-_]?token|refresh[-_]?token|secret[-_]?token|client[-_]?secret|private[-_]?key|id[-_]?token)\\s*(?:[=:]|:\\s*)\\s*([\"']?))([a-zA-Z0-9\\-._~+/%=]{6,})(\\2)",
      "flags": "gi",
      "replacement": "$1[REDACTED]$4"
    }
  ],
  "survivingPatterns": [
    "sk-ant-",
    "sk-[a-zA-Z0-9_\\-]{16,}",
    "AIzaSy",
    "Bearer\\s+[A-Za-z0-9]",
    "ghp_",
    "github_pat_",
    "gho_",
    "xox[aboprs]-",
    "ya29\\.",
    "1//[0-9A-Za-z_-]{8,}",
    "-----BEGIN"
  ],
  "substringMarkers": [
    "authorization:",
    "bearer ",
    "cookie:",
    "access_token",
    "refresh_token",
    "client_secret",
    "x-api-key",
    "api_key",
    "apikey",
    "xoxb-",
    "xoxp-",
    "xoxa-",
    "xoxr-",
    "xoxs-",
    "ghp_",
    "github_pat_",
    "gho_",
    "ya29.",
    "aizasy",
    "sk-",
    "-----begin",
    "password=",
    "passwd=",
    "secret=",
    "token=",
    "api_key=",
    "access_token="
  ],
  "sensitiveKeyStems": [
    "apikey",
    "token",
    "password",
    "passwd",
    "secret",
    "credential",
    "credentials",
    "authorization",
    "cookie",
    "sessiontoken",
    "accesstoken",
    "refreshtoken",
    "secrettoken",
    "clientsecret",
    "privatekey",
    "idtoken",
    "xapikey"
  ],
  "sensitiveKeyPattern": "^(api[-_]?key|x-api-key|token|password|passwd|secret|credential|credentials|authorization|cookie|session[-_]?token|access[-_]?token|refresh[-_]?token|secret[-_]?token|client[-_]?secret|private[-_]?key|id[-_]?token)$",
  "cases": [
    {
      "id": "openai-key",
      "input": "my key is sk-12345678901234567890abc123",
      "looksSecret": true,
      "mustNotContain": ["sk-12345678901234567890abc123"]
    },
    {
      "id": "anthropic-key",
      "input": "bearer sk-ant-12345678901234567890abc123",
      "looksSecret": true,
      "mustNotContain": ["sk-ant-12345678901234567890abc123"]
    },
    {
      "id": "google-api-key",
      "input": "Gemini key is AIzaSy123456789012345678901234567890abc",
      "looksSecret": true,
      "mustNotContain": ["AIzaSy123456789012345678901234567890abc"]
    },
    {
      "id": "bearer-header",
      "input": "Authorization: Bearer abcdefghij1234567890",
      "looksSecret": true,
      "mustNotContain": ["abcdefghij1234567890"]
    },
    {
      "id": "token-assignment",
      "input": "token=my-secret-token",
      "looksSecret": true,
      "mustNotContain": ["my-secret-token"]
    },
    {
      "id": "api-key-assignment",
      "input": "api_key: \"super_secret_value\"",
      "looksSecret": true,
      "mustNotContain": ["super_secret_value"]
    },
    {
      "id": "github-classic-pat",
      "input": "export GITHUB_TOKEN=ghp_abcdefghijklmnopqrstuvwx1234567890",
      "looksSecret": true,
      "mustNotContain": ["ghp_abcdefghijklmnopqrstuvwx1234567890"]
    },
    {
      "id": "github-fine-grained-pat",
      "input": "token=github_pat_11AAAAAAA0abcdefghijklmnopqrstuvwxyz012345",
      "looksSecret": true,
      "mustNotContain": ["github_pat_11AAAAAAA0abcdefghijklmnopqrstuvwxyz012345"]
    },
    {
      "id": "github-oauth-token",
      "input": "Authorization: token gho_abcdefghijklmnopqrstuvwx1234567890",
      "looksSecret": true,
      "mustNotContain": ["gho_abcdefghijklmnopqrstuvwx1234567890"]
    },
    {
      "id": "slack-bot-token",
      "input": "xoxb-fixturenotarealslacktoken",
      "looksSecret": true,
      "mustNotContain": ["xoxb-fixturenotarealslacktoken"]
    },
    {
      "id": "google-access-token",
      "input": "access_token=ya29.a0ATt-leaked-google-access-token",
      "looksSecret": true,
      "mustNotContain": ["ya29.a0ATt-leaked-google-access-token"]
    },
    {
      "id": "google-refresh-token",
      "input": "refresh_token=1//0eLeakedGoogleRefreshTokenValue",
      "looksSecret": true,
      "mustNotContain": ["1//0eLeakedGoogleRefreshTokenValue"]
    },
    {
      "id": "pem-private-key",
      "input": "-----BEGIN PRIVATE KEY-----\nMIIBfakePrivateKeyMaterial\n-----END PRIVATE KEY-----",
      "looksSecret": true,
      "mustNotContain": ["MIIBfakePrivateKeyMaterial"]
    },
    {
      "id": "ordinary-read-file",
      "input": "read-file src/index.ts",
      "looksSecret": false,
      "mustNotContain": []
    },
    {
      "id": "ordinary-github-read",
      "input": "github-read repo issues",
      "looksSecret": false,
      "mustNotContain": []
    }
  ]
}
