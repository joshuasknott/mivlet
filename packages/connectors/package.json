{
  "name": "@mivlet/connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime/index.d.ts",
      "import": "./dist/agent-runtime/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    },
    "./backends/*": {
      "types": "./dist/backends/*.d.ts",
      "import": "./dist/backends/*.js"
    },
    "./mcp/*": {
      "types": "./dist/mcp/*.d.ts",
      "import": "./dist/mcp/*.js"
    },
    "./native-api/*": {
      "types": "./dist/native-api/*.d.ts",
      "import": "./dist/native-api/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./knowledge-search": {
      "types": "./dist/knowledge-search.d.ts",
      "import": "./dist/knowledge-search.js"
    },
    "./local-files": {
      "types": "./dist/local-files.d.ts",
      "import": "./dist/local-files.js"
    },
    "./permission-policy": {
      "types": "./dist/permission-policy.d.ts",
      "import": "./dist/permission-policy.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @mivlet/protocol build",
    "test": "vitest run"
  },
  "dependencies": {
    "@mivlet/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
