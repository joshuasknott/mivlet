# Copy to .dev.vars for local development. Never commit the real values.
# Service Bearer (lifecycle provision/status/destroy) and HMAC signing must be distinct.
MIVLET_HOSTED_RUNNER_API_KEY=replace-with-a-long-random-service-secret
MIVLET_HOSTED_RUNNER_SIGNING_KEY=replace-with-a-different-long-random-signing-secret
