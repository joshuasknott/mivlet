{
  "name": "@mivlet/hosted-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mivlet-managed isolated execution computer. Deployable, not deployed.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @mivlet/protocol build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "worker:types": "wrangler types --config wrangler.jsonc",
    "worker:dev": "wrangler dev --config wrangler.jsonc --port 8789",
    "worker:deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc --containers-rollout=immediate",
    "tasks:types": "wrangler types --config wrangler.tasks.jsonc tasks-configuration.d.ts",
    "tasks:dev": "wrangler dev --config wrangler.tasks.jsonc --port 8790",
    "tasks:deploy:dry-run": "wrangler deploy --config wrangler.tasks.jsonc --dry-run",
    "tasks:deploy": "wrangler deploy --config wrangler.tasks.jsonc"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.13.0-next.738.2",
    "@mivlet/connectors": "workspace:*",
    "@mivlet/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.105.0"
  }
}
