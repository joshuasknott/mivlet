---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

type EcosystemItem = {
  name: string;
  icon: string;
  color?: string;
  image?: boolean;
  className?: string;
};

const providers: EcosystemItem[] = [
  { name: 'ChatGPT', icon: '/provider-icons/openai.svg', color: '#111111' },
  { name: 'OpenAI API', icon: '/provider-icons/openai.svg', color: '#111111' },
  { name: 'Claude', icon: '/provider-icons/claude.svg', color: '#d97757' },
  { name: 'Gemini', icon: '/provider-icons/gemini.svg', image: true },
  { name: 'xAI', icon: '/provider-icons/grok.svg', color: '#111111' },
  { name: 'Custom API', icon: '/provider-icons/custom.svg', image: true },
];

const connectors: EcosystemItem[] = [
  { name: 'Google Drive', icon: '/provider-icons/google-drive.svg', image: true },
  { name: 'Gmail', icon: '/provider-icons/gmail.svg', image: true },
  { name: 'Google Calendar', icon: '/provider-icons/calendar.svg', image: true },
  { name: 'Slack', icon: '/provider-icons/slack.svg', image: true },
  { name: 'GitHub', icon: '/provider-icons/github.svg', color: '#111111' },
  { name: 'Vercel', icon: '/provider-icons/vercel.svg', color: '#111111' },
  { name: 'Notion', icon: '/provider-icons/notion.svg', color: '#111111' },
  { name: 'Linear', icon: '/provider-icons/linear.svg', color: '#5e6ad2' },
];
---
<Layout
  pageClass="home-page"
  title="Fable — Where people and agents build together"
  description="One calm workspace where people and agents think, create, build, and scale together."
>
  <section id="hero" class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker">The operating layer for human-agent work</p>
      <h1 id="hero-title" aria-label="Where people and agents build together.">
        Where people and agents
        <span class="headline-line">
          <span class="rotating-word" aria-hidden="true">build</span>
          <span> together.</span>
        </span>
      </h1>
      <p class="hero-body">
        Talk with a named teammate. Fable keeps the context, asks before consequential actions, and remembers the result.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="btn btn-dark" href="#updates">Join the waitlist</a>
        <a class="btn btn-quiet" href="#product">Explore the product</a>
      </div>
    </div>

    <figure id="product" class="product-shot product-shot--hero">
      <img
        src="/product-shots/fable-workspace.jpg"
        alt="Fable workspace with its navigation and central conversational composer"
        width="1440"
        height="900"
        loading="eager"
      />
      <figcaption>A quiet starting point for anything you want to get done.</figcaption>
    </figure>
  </section>

  <section class="story-section story-section--intro" aria-labelledby="superapp-title">
    <div class="story-heading">
      <p class="section-label">One place for the whole job</p>
      <h2 id="superapp-title">The superapp for work.</h2>
    </div>
    <div class="story-copy story-copy--columns">
      <p>Start with an ordinary conversation. Fable understands the workspace, sources, people, tools, and authority that matter.</p>
      <p>When work needs tools, your teammate can use approved sources or its isolated computer, pausing exactly where your judgement is needed.</p>
      <p>The conversation keeps its useful context: sources, decisions, action history, and the result you can keep refining.</p>
    </div>
  </section>

  <section id="providers" class="ecosystem-section ecosystem-section--providers" aria-labelledby="providers-title">
    <div class="ecosystem-heading">
      <p class="section-label">Providers</p>
      <h2 id="providers-title">Use the models you choose.</h2>
      <p>Choose ChatGPT browser sign-in or connect a supported API directly.</p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="7" tabindex="0" aria-label="AI provider ecosystem">
      <div class="ecosystem-set">
        {providers.map((provider) => (
          <div class="ecosystem-item">
            {provider.image ? (
              <span class:list={['brand-logo', 'brand-logo--image', provider.className]}>
                <img src={provider.icon} alt="" loading="lazy" />
              </span>
            ) : (
              <span
                class="brand-logo brand-logo--mask"
                aria-hidden="true"
                style={`--icon: url("${provider.icon}"); --brand: ${provider.color};`}
              ></span>
            )}
            <span>{provider.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="product-story product-story--knowledge" aria-labelledby="knowledge-title">
    <div class="product-story__copy">
      <p class="section-label">Knowledge and memory</p>
      <h2 id="knowledge-title">Your work stays useful.</h2>
      <p>
        Sources and memories stay visible and scoped. Fable can find the right context, show where it came from, and carry it into the conversation.
      </p>
      <ul class="story-points">
        <li>Search across files, notes, and connected services.</li>
        <li>Keep memories visible, scoped, and editable.</li>
        <li>Keep useful context attached to the conversation.</li>
      </ul>
    </div>
    <figure class="product-shot product-shot--story">
      <img
        src="/product-shots/fable-knowledge.png"
        alt="Fable Knowledge showing sources, memories, search, and import controls"
        width="1440"
        height="1024"
        loading="lazy"
      />
      <figcaption>Everything Fable can use as context, in one calm library.</figcaption>
    </figure>
  </section>

  <section class="product-story product-story--connections" aria-labelledby="connections-story-title">
    <figure class="product-shot product-shot--story">
      <img
        src="/product-shots/fable-connections.png"
        alt="Fable Connections showing GitHub, Vercel, Google Drive, Notion, Gmail, Slack, Google Calendar, and Linear"
        width="1280"
        height="760"
        loading="lazy"
      />
      <figcaption>Connections stay explicit, inspectable, and under your control.</figcaption>
    </figure>
    <div class="product-story__copy">
      <p class="section-label">Connections and authority</p>
      <h2 id="connections-story-title">Bring the tools around your work.</h2>
      <p>
        Connect the services you choose, decide what Fable can read or prepare, and keep consequential actions behind an exact approval.
      </p>
      <ul class="story-points">
        <li>Provider routes and business connections stay separate.</li>
        <li>Read, draft, publish, and destructive authority are distinct.</li>
        <li>You can see what acted, where it ran, and what changed.</li>
      </ul>
    </div>
  </section>

  <section id="connectors" class="ecosystem-section ecosystem-section--connectors" aria-labelledby="connectors-title">
    <div class="ecosystem-heading">
      <p class="section-label">Connectors</p>
      <h2 id="connectors-title">Connect the tools around your work.</h2>
      <p>Give Fable the context and capabilities a job needs, without handing over more authority than it requires.</p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="6" tabindex="0" aria-label="Connector ecosystem">
      <div class="ecosystem-set">
        {connectors.map((connector) => (
          <div class="ecosystem-item">
            {connector.image ? (
              <span class="brand-logo brand-logo--image">
                <img src={connector.icon} alt="" loading="lazy" />
              </span>
            ) : (
              <span
                class="brand-logo brand-logo--mask"
                aria-hidden="true"
                style={`--icon: url("${connector.icon}"); --brand: ${connector.color};`}
              ></span>
            )}
            <span>{connector.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-story" aria-labelledby="closing-title">
    <div>
      <p class="section-label">Simple at every depth</p>
      <h2 id="closing-title">Ask naturally. Stay in control.</h2>
    </div>
    <p>
      Provider choice, Connections, voice, browser use, computer control, and approvals are there when the work needs them—not before.
    </p>
  </section>

  <section id="updates" class="updates-section updates-section--home" aria-labelledby="updates-title">
    <div class="updates-copy">
      <p class="section-label">Fable updates</p>
      <h2 id="updates-title">Join the waitlist.</h2>
      <p>Be the first to hear about access, major product releases, and what Fable can do next.</p>
      <div class="updates-note" aria-label="Waitlist details">
        <span>One email when it matters.</span>
        <span>No account or product data required.</span>
      </div>
    </div>
    <WaitlistForm />
  </section>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const rotatingWord = document.querySelector<HTMLElement>('.rotating-word');
  const words = ['think', 'create', 'build', 'scale'];
  let wordIndex = words.indexOf(rotatingWord?.textContent?.trim() ?? 'build');

  if (rotatingWord && !reducedMotion.matches) {
    window.setInterval(() => {
      rotatingWord.classList.add('is-changing');
      window.setTimeout(() => {
        wordIndex = (wordIndex + 1) % words.length;
        rotatingWord.textContent = words[wordIndex];
        rotatingWord.classList.remove('is-changing');
      }, 120);
    }, 2200);
  }

  document.querySelectorAll<HTMLElement>('[data-auto-rail]').forEach((rail) => {
    let paused = false;
    let dragging = false;
    let direction = 1;
    let startX = 0;
    let startScroll = 0;
    let lastFrame = performance.now();
    let resumeTimer = 0;
    const speed = Number(rail.dataset.speed ?? 6);

    const resumeSoon = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        paused = false;
      }, 1000);
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - lastFrame, 50);
      lastFrame = time;
      if (!paused && !reducedMotion.matches) {
        const maxScroll = rail.scrollWidth - rail.clientWidth;
        if (maxScroll > 1) {
          rail.scrollLeft += direction * speed * (elapsed / 1000);
          if (rail.scrollLeft >= maxScroll - 1) direction = -1;
          if (rail.scrollLeft <= 1) direction = 1;
        }
      }
      requestAnimationFrame(animate);
    };

    rail.addEventListener('pointerdown', (event) => {
      dragging = true;
      paused = true;
      startX = event.clientX;
      startScroll = rail.scrollLeft;
      rail.setPointerCapture(event.pointerId);
      rail.classList.add('is-dragging');
    });

    rail.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      rail.scrollLeft = startScroll - (event.clientX - startX);
    });

    const stopDragging = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      rail.releasePointerCapture(event.pointerId);
      rail.classList.remove('is-dragging');
      resumeSoon();
    };

    rail.addEventListener('pointerup', stopDragging);
    rail.addEventListener('pointercancel', stopDragging);
    rail.addEventListener('wheel', () => {
      paused = true;
      resumeSoon();
    }, { passive: true });
    rail.addEventListener('mouseenter', () => { paused = true; });
    rail.addEventListener('mouseleave', () => { if (!dragging) resumeSoon(); });
    rail.addEventListener('focusin', () => { paused = true; });
    rail.addEventListener('focusout', resumeSoon);

    requestAnimationFrame(animate);
  });
</script>
