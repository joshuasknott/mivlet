---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const providers = [
  { name: 'Codex', icon: '/provider-icons/codex.svg' },
  { name: 'Cursor', icon: '/provider-icons/cursor.svg' },
  { name: 'Claude', icon: '/provider-icons/claude.svg' },
  { name: 'Grok', icon: '/provider-icons/grok.svg' },
  { name: 'GitHub Copilot', icon: '/provider-icons/github-copilot.svg' },
  { name: 'Gemini', icon: '/provider-icons/gemini.svg' },
  { name: 'OpenAI', icon: '/provider-icons/openai.svg' },
  { name: 'Z.ai', icon: '/provider-icons/zai.svg' },
  { name: 'DeepSeek', icon: '/provider-icons/deepseek.svg' },
  { name: 'MiniMax', icon: '/provider-icons/minimax.svg' },
  { name: 'Kimi', icon: '/provider-icons/kimi.svg' },
  { name: 'OpenCode', icon: '/provider-icons/opencode.svg' },
];

const pillars = [
  {
    title: 'Local-first',
    body: 'Private context starts on your machine, with clear boundaries before anything leaves it.',
  },
  {
    title: 'Open source',
    body: 'Runtime contracts, adapter boundaries, and local data formats are built to be inspectable.',
  },
  {
    title: 'Permissioned',
    body: 'Files, tools, memory, schedules, and external actions stay visible before work is delegated.',
  },
];

const connectors = [
  { name: 'GitHub', icon: '/provider-icons/github.svg' },
  { name: 'Vercel', icon: '/provider-icons/vercel.svg' },
  { name: 'Google Drive', icon: '/provider-icons/google-drive.svg' },
  { name: 'Gmail', icon: '/provider-icons/gmail.svg' },
  { name: 'Calendar', icon: '/provider-icons/calendar.svg' },
  { name: 'Slack', icon: '/provider-icons/slack.svg' },
  { name: 'Notion', icon: '/provider-icons/notion.svg' },
  { name: 'Linear', icon: '/provider-icons/linear.svg' },
];
---
<Layout title="Fable | Local-first AI, open by design" description="Fable is a local-first, open-source command surface for AI providers, files, tools, memory, schedules, and approvals.">
  <section id="hero" class="home-hero" aria-labelledby="hero-title">
    <div class="hero-light" aria-hidden="true"></div>

    <div class="hero-copy">
      <img class="dragon-mark" src="/brand/fable-tech-dragon-transparent.png" alt="Minimal Fable technology dragon mark" loading="eager" />
      <p class="eyebrow">Local-first AI. Open by design.</p>
      <h1 id="hero-title">Fable</h1>
      <p class="hero-subtitle">Your local command surface for AI.</p>
      <p class="hero-body">
        Use the models you choose. Keep context, approvals, and execution under your control.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="btn btn-light" href="#updates">Get updates</a>
        <a class="btn btn-ghost" href="#connectors">View connectors</a>
      </div>
    </div>
  </section>

  <section id="providers" class="section providers-section" aria-labelledby="providers-title">
    <div class="section-heading split">
      <div>
        <p class="eyebrow dark">Providers</p>
        <h2 id="providers-title">Use the models you choose.</h2>
      </div>
      <p>
        Bring subscription tools, hosted APIs, and open runtimes into one local command surface without locking the workspace to one provider.
      </p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="22" tabindex="0" aria-label="AI provider ecosystem">
      <div class="ecosystem-track">
        <div class="ecosystem-set">
          {providers.map((provider) => (
            <div class="ecosystem-item provider-item">
              <img src={provider.icon} alt="" aria-hidden="true" loading="lazy" draggable="false" />
              <span>{provider.name}</span>
            </div>
          ))}
        </div>
        <div class="ecosystem-set" aria-hidden="true">
          {providers.map((provider) => (
            <div class="ecosystem-item provider-item">
              <img src={provider.icon} alt="" aria-hidden="true" loading="lazy" draggable="false" />
              <span>{provider.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="product" class="section product-section" aria-labelledby="product-title">
    <div class="section-heading">
      <p class="eyebrow dark">Product</p>
      <h2 id="product-title">Built local-first. Open by default.</h2>
      <p>
        Fable organizes models, files, context, memory, schedules, and approvals into one controlled workspace.
      </p>
    </div>
    <div class="pillar-grid">
      {pillars.map((pillar, index) => (
        <article class="pillar">
          <span class="pillar-icon" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="connectors" class="section connectors-section" aria-labelledby="connectors-title">
    <div class="section-heading split">
      <div>
        <p class="eyebrow dark">Connectors</p>
        <h2 id="connectors-title">Connect the tools around your work.</h2>
      </div>
      <p>
        Providers supply the intelligence. Connectors are explicit bridges to the tools, files, and services around your workspace.
      </p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="18" tabindex="0" aria-label="Connector ecosystem">
      <div class="ecosystem-track">
        <div class="ecosystem-set">
          {connectors.map((connector) => (
            <div class="ecosystem-item connector-item">
              <img src={connector.icon} alt="" aria-hidden="true" loading="lazy" draggable="false" />
              <span>{connector.name}</span>
            </div>
          ))}
        </div>
        <div class="ecosystem-set" aria-hidden="true">
          {connectors.map((connector) => (
            <div class="ecosystem-item connector-item">
              <img src={connector.icon} alt="" aria-hidden="true" loading="lazy" draggable="false" />
              <span>{connector.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="updates" class="section updates-section" aria-labelledby="updates-title">
    <div class="updates-copy">
      <p class="eyebrow dark">Updates</p>
      <h2 id="updates-title">Follow the product as it opens up.</h2>
      <p>
        Join the Fable list for product updates. This is not a hosted workspace account and does not give Fable access to your local data.
      </p>
    </div>
    <WaitlistForm />
  </section>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-auto-rail]').forEach((rail) => {
    let paused = false;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let lastFrame = performance.now();
    let resumeTimer = 0;
    const speed = Number(rail.dataset.speed ?? 20);

    const resumeSoon = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        paused = false;
      }, 900);
    };

    const normalizeScroll = () => {
      const midpoint = rail.scrollWidth / 2;
      if (midpoint > 0 && rail.scrollLeft >= midpoint) rail.scrollLeft -= midpoint;
      if (rail.scrollLeft < 0) rail.scrollLeft += midpoint;
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - lastFrame, 50);
      lastFrame = time;
      if (!paused && !reducedMotion.matches) {
        rail.scrollLeft += speed * (elapsed / 1000);
        normalizeScroll();
      }
      requestAnimationFrame(animate);
    };

    rail.addEventListener('pointerdown', (event) => {
      dragging = true;
      paused = true;
      startX = event.clientX;
      startScroll = rail.scrollLeft;
      rail.setPointerCapture(event.pointerId);
      rail.classList.add('is-dragging');
    });

    rail.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      rail.scrollLeft = startScroll - (event.clientX - startX);
    });

    const stopDragging = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      rail.releasePointerCapture(event.pointerId);
      rail.classList.remove('is-dragging');
      normalizeScroll();
      resumeSoon();
    };

    rail.addEventListener('pointerup', stopDragging);
    rail.addEventListener('pointercancel', stopDragging);
    rail.addEventListener('wheel', () => {
      paused = true;
      resumeSoon();
    }, { passive: true });
    rail.addEventListener('mouseenter', () => {
      paused = true;
    });
    rail.addEventListener('mouseleave', () => {
      if (!dragging) resumeSoon();
    });
    rail.addEventListener('focusin', () => {
      paused = true;
    });
    rail.addEventListener('focusout', resumeSoon);

    requestAnimationFrame(animate);
  });
</script>
