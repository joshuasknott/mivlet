---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const providers = [
  { name: 'Codex', icon: '/provider-icons/codex.svg', color: '#ffffff' },
  { name: 'Cursor', icon: '/provider-icons/cursor.svg', color: '#ffffff' },
  { name: 'Claude', icon: '/provider-icons/claude.svg', color: '#d97757' },
  { name: 'Grok', icon: '/provider-icons/grok.svg', color: '#ffffff' },
  { name: 'GitHub Copilot', icon: '/provider-icons/github-copilot.svg', color: '#7c5cff' },
  { name: 'Gemini', icon: '/provider-icons/gemini.svg', color: '#8e75b2' },
  { name: 'OpenAI', icon: '/provider-icons/openai.svg', color: '#ffffff' },
  { name: 'Z.ai', icon: '/provider-icons/zai.svg', color: '#e3e3e3' },
  { name: 'DeepSeek', icon: '/provider-icons/deepseek.svg', color: '#5786fe' },
  { name: 'MiniMax', icon: '/provider-icons/minimax.svg', color: '#e73562' },
  { name: 'Kimi', icon: '/provider-icons/kimi.svg', color: '#ffffff' },
  { name: 'OpenCode', icon: '/provider-icons/opencode.svg', color: '#33b8ff' },
];

const pillars = [
  {
    title: 'Local-first',
    body: 'Private context starts on your machine, with clear boundaries before anything leaves it.',
  },
  {
    title: 'Open source',
    body: 'Runtime contracts, adapter boundaries, and local data formats are built to be inspectable.',
  },
  {
    title: 'Permissioned',
    body: 'Files, tools, memory, schedules, and external actions stay visible before work is delegated.',
  },
];

const connectors = [
  { name: 'GitHub', icon: '/provider-icons/github.svg', color: '#ffffff' },
  { name: 'Vercel', icon: '/provider-icons/vercel.svg', color: '#ffffff' },
  { name: 'Google Drive', icon: '/provider-icons/google-drive.svg', color: '#4285f4' },
  { name: 'Gmail', icon: '/provider-icons/gmail.svg', color: '#ea4335' },
  { name: 'Calendar', icon: '/provider-icons/calendar.svg', color: '#4285f4' },
  { name: 'Slack', icon: '/provider-icons/slack.svg', color: '#e01e5a' },
  { name: 'Notion', icon: '/provider-icons/notion.svg', color: '#ffffff' },
  { name: 'Linear', icon: '/provider-icons/linear.svg', color: '#5e6ad2' },
];
---
<Layout title="Fable — Where people and agents build together" description="A local-first, open-source workspace for thinking, creating, and getting real work done with AI.">
  <section id="hero" class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <img class="dragon-mark" src="/brand/fable-tech-dragon-transparent.png" alt="" loading="eager" />
      <h1 id="hero-title" aria-label="Where people and agents build together.">
        Where people and agents
        <span class="headline-line">
          <span class="rotating-word" aria-hidden="true">build</span>
          <span> together.</span>
        </span>
      </h1>
      <p class="hero-body">
        A local-first, open-source workspace for thinking, creating, and getting real work done with AI.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="btn btn-light" href="#updates">Join the waitlist</a>
        <a class="btn btn-ghost" href="#product">Explore the product</a>
      </div>
    </div>

    <div id="product" class="product-demo" aria-label="Animated Fable product preview">
      <div class="demo-frame">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/fable-product-demo-poster.jpg"
          aria-label="Fable workspace showing delegated tasks, connected tools, and an approval"
        >
          <source src="/fable-product-demo.mp4" type="video/mp4" />
        </video>
      </div>
      <p class="demo-caption">Work stays visible. External actions wait for your approval.</p>
    </div>
  </section>

  <section id="providers" class="section providers-section" aria-labelledby="providers-title">
    <div class="section-heading">
      <p class="section-label">Providers</p>
      <h2 id="providers-title">Use the models you choose.</h2>
      <p>Bring the providers you already use into one local workspace.</p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="22" tabindex="0" aria-label="AI provider ecosystem">
      <div class="ecosystem-track">
        <div class="ecosystem-set">
          {providers.map((provider) => (
            <div class="ecosystem-item provider-item" style={`--icon: url("${provider.icon}"); --brand: ${provider.color};`}>
              <span class="ecosystem-logo" aria-hidden="true"></span>
              <span>{provider.name}</span>
            </div>
          ))}
        </div>
        <div class="ecosystem-set" aria-hidden="true">
          {providers.map((provider) => (
            <div class="ecosystem-item provider-item" style={`--icon: url("${provider.icon}"); --brand: ${provider.color};`}>
              <span class="ecosystem-logo" aria-hidden="true"></span>
              <span>{provider.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="principles" class="section product-section" aria-labelledby="product-title">
    <div class="section-heading">
      <p class="section-label">Product principles</p>
      <h2 id="product-title">Built local-first. Open by default.</h2>
      <p>Bring files, tools, memory, schedules, and approvals together without giving up control.</p>
    </div>
    <div class="pillar-grid">
      {pillars.map((pillar, index) => (
        <article class="pillar">
          <span class="pillar-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="connectors" class="section connectors-section" aria-labelledby="connectors-title">
    <div class="section-heading">
      <p class="section-label">Connectors</p>
      <h2 id="connectors-title">Connect the tools around your work.</h2>
      <p>Explicit bridges to the files and services your work already depends on.</p>
    </div>
    <div class="ecosystem-rail" data-auto-rail data-speed="18" tabindex="0" aria-label="Connector ecosystem">
      <div class="ecosystem-track">
        <div class="ecosystem-set">
          {connectors.map((connector) => (
            <div class="ecosystem-item connector-item" style={`--icon: url("${connector.icon}"); --brand: ${connector.color};`}>
              <span class="ecosystem-logo" aria-hidden="true"></span>
              <span>{connector.name}</span>
            </div>
          ))}
        </div>
        <div class="ecosystem-set" aria-hidden="true">
          {connectors.map((connector) => (
            <div class="ecosystem-item connector-item" style={`--icon: url("${connector.icon}"); --brand: ${connector.color};`}>
              <span class="ecosystem-logo" aria-hidden="true"></span>
              <span>{connector.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="updates" class="section updates-section" aria-labelledby="updates-title">
    <div class="updates-copy">
      <img src="/brand/fable-tech-dragon-transparent.png" alt="" class="updates-mark" />
      <h2 id="updates-title">Get Fable updates.</h2>
      <p>Product news and preview access. No account required.</p>
    </div>
    <WaitlistForm />
  </section>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const rotatingWord = document.querySelector<HTMLElement>('.rotating-word');
  const words = ['think', 'create', 'build', 'scale'];
  let wordIndex = words.indexOf(rotatingWord?.textContent?.trim() ?? 'build');

  if (rotatingWord && !reducedMotion.matches) {
    window.setInterval(() => {
      wordIndex = (wordIndex + 1) % words.length;
      rotatingWord.textContent = words[wordIndex];
    }, 2600);
  }

  document.querySelectorAll<HTMLElement>('[data-auto-rail]').forEach((rail) => {
    let paused = false;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let lastFrame = performance.now();
    let resumeTimer = 0;
    const speed = Number(rail.dataset.speed ?? 20);

    const resumeSoon = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        paused = false;
      }, 1100);
    };

    const normalizeScroll = () => {
      const midpoint = rail.scrollWidth / 2;
      if (midpoint > 0 && rail.scrollLeft >= midpoint) rail.scrollLeft -= midpoint;
      if (rail.scrollLeft < 0) rail.scrollLeft += midpoint;
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - lastFrame, 50);
      lastFrame = time;
      if (!paused && !reducedMotion.matches) {
        rail.scrollLeft += speed * (elapsed / 1000);
        normalizeScroll();
      }
      requestAnimationFrame(animate);
    };

    rail.addEventListener('pointerdown', (event) => {
      dragging = true;
      paused = true;
      startX = event.clientX;
      startScroll = rail.scrollLeft;
      rail.setPointerCapture(event.pointerId);
      rail.classList.add('is-dragging');
    });

    rail.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      rail.scrollLeft = startScroll - (event.clientX - startX);
    });

    const stopDragging = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      rail.releasePointerCapture(event.pointerId);
      rail.classList.remove('is-dragging');
      normalizeScroll();
      resumeSoon();
    };

    rail.addEventListener('pointerup', stopDragging);
    rail.addEventListener('pointercancel', stopDragging);
    rail.addEventListener('wheel', () => {
      paused = true;
      resumeSoon();
    }, { passive: true });
    rail.addEventListener('mouseenter', () => {
      paused = true;
    });
    rail.addEventListener('mouseleave', () => {
      if (!dragging) resumeSoon();
    });
    rail.addEventListener('focusin', () => {
      paused = true;
    });
    rail.addEventListener('focusout', resumeSoon);

    requestAnimationFrame(animate);
  });
</script>
