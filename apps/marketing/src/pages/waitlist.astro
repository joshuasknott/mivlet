---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---
<Layout title="Join the Fable waitlist" description="Sign up for the Windows preview waitlist.">
  <div style="max-width: 600px; margin: 2rem auto;">
    <h1>Join the Fable Windows preview waitlist</h1>

    <p>We are preparing an unsigned Windows preview. Waitlist sign-up does not create a Fable account and does not grant early access by itself.</p>

    <div class="honest-box">
      <strong>Onboarding & Privacy:</strong>
      Fable's core desktop workspace runs locally without a hosted account. Waitlist data is stored separately from OAuth connector credentials.
    </div>

    <WaitlistForm />
  </div>
</Layout>
