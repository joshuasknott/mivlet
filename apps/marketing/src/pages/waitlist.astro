---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---
<Layout title="Join the Fable waitlist" description="Product news and preview access for Fable. No account required.">
  <section class="section updates-section standalone-waitlist" aria-labelledby="waitlist-title">
    <div class="updates-copy">
      <img src="/brand/fable-mark.png" alt="" class="updates-mark" />
      <h1 id="waitlist-title">Join the Fable waitlist.</h1>
      <p>Product news and preview access. No account required.</p>
      <div class="honest-box">
        Fable's desktop workspace runs locally. Waitlist data is stored separately from connector credentials and does not provide access to your local files.
      </div>
    </div>
    <WaitlistForm />
  </section>
</Layout>
