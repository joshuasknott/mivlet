---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Fable Status Matrix">
  <div style="margin-top: 2rem; margin-bottom: 2rem;">
    <h1>System Status (Snapshot)</h1>
    <p>Last audited: 2026-06-30 from <code>docs/product/status.md</code></p>
    
    <div class="card" style="padding: 0;">
      <table style="margin: 0; width: 100%;">
        <thead>
          <tr>
            <th>Component</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Desktop shell, local files, memory controls, knowledge search, runtime snapshots</td>
            <td><span class="status implemented">Implemented</span></td>
          </tr>
          <tr>
            <td>Google connectors (Drive, Gmail, Calendar)</td>
            <td><span class="status gated">Functional but gated</span></td>
          </tr>
          <tr>
            <td>Confidential connectors (GitHub, Vercel, Notion, Slack, Linear)</td>
            <td><span class="status gated">Functional but gated</span></td>
          </tr>
          <tr>
            <td>Local models, GitHub writes</td>
            <td><span class="status missing">Missing</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="fine" style="margin-top: 1.5rem;">Full detail is available inside the repository's <code>docs/product/status.md</code>. This page serves as a static mirror for public reference.</p>
  </div>
</Layout>
