---
const WAITLIST_ENDPOINT = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? 'http://localhost:8789/v1/signup';
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
const WAITLIST_CONTACT_EMAIL = import.meta.env.PUBLIC_WAITLIST_CONTACT_EMAIL ?? 'hello@example.invalid';
const CONSENT_VERSION = '2026-07-03-waitlist-v0.1';
---
<form id="waitlist-form" class="waitlist-form" method="POST" action={WAITLIST_ENDPOINT} accept-charset="utf-8">
  <div class="field-group">
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" />
  </div>

  <fieldset>
    <legend>Product interest (optional)</legend>
    <label><input type="radio" name="platform_interest" value="unspecified" checked /> Product updates</label>
    <label><input type="radio" name="platform_interest" value="macos" /> macOS</label>
    <label><input type="radio" name="platform_interest" value="linux" /> Linux</label>
    <label><input type="radio" name="platform_interest" value="windows" /> Windows</label>
  </fieldset>

  <!-- Honeypot -->
  <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
    <label for="website">Website (leave empty)</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label class="checkbox-label">
    <input type="checkbox" name="consent_marketing" value="true" required aria-describedby="consent-desc" />
    <span>I agree to receive waitlist and product update emails from Fable.</span>
  </label>
  <p id="consent-desc" class="fine">
    See our <a href="/privacy-policy">Privacy Policy</a> for how we handle your information.
  </p>
  <details class="consent-details">
    <summary>Consent details</summary>
    <p>
      Notice {CONSENT_VERSION}. Joining the waitlist does not create a Fable account, guarantee access, or give Fable access to your local workspace.
    </p>
  </details>

  <div id="turnstile-container">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
  </div>
  <input type="hidden" name="consent_version" value={CONSENT_VERSION} />
  <input type="hidden" name="turnstile_token" id="turnstile_token" />

  <noscript>
    <div class="fallback">
      JavaScript is required for the verification step. You can join by emailing <a href={`mailto:${WAITLIST_CONTACT_EMAIL}?subject=Waitlist%20signup`}>{WAITLIST_CONTACT_EMAIL}</a>.
    </div>
  </noscript>

  <button type="submit">Join the waitlist</button>
  <p class="fine form-status" id="form-status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('waitlist-form');
  if (form) {
    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      (form as HTMLFormElement).action = 'http://localhost:8789/v1/signup';
    }
    form.addEventListener('submit', async (e) => {
      const ts = (window as any).turnstile;
      if (!ts) return;
      e.preventDefault();
      const fd = new FormData(form as HTMLFormElement);
      const turnstileResponse = (form.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement)?.value || '';
      if (turnstileResponse) {
        fd.set('turnstile_token', turnstileResponse);
      }
      const status = document.getElementById('form-status');
      if (status) status.textContent = 'Joining…';
      try {
        const res = await fetch((form as HTMLFormElement).action, {
          method: 'POST',
          body: fd
        });
        if (res.status === 202) {
          window.location.href = '/waitlist/confirmed';
        } else if (status) {
          status.textContent = 'There was a problem. Please try again or use the email fallback.';
        }
      } catch {
        if (status) status.textContent = 'The waitlist service is unavailable. Please try again shortly.';
      }
    });
  }
</script>
