---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  pageClass?: string;
}
const { title, description = "Local-first AI, open by design.", noindex = false, pageClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://fable.tools').href;
const year = 2026;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/brand/fable-mark.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-image.png" />
  <meta name="theme-color" content={pageClass === 'home-page' ? '#fbfbfa' : '#050505'} />
  <meta name="color-scheme" content={pageClass === 'home-page' ? 'light' : 'dark'} />
</head>
<body class={pageClass}>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Primary">
      <a href="/" class="logo-container" aria-label="Fable home">
        <img src="/brand/fable-tech-dragon-transparent.png" alt="" class="logo-image" />
        <span class="logo-wordmark">Fable</span>
      </a>
      <ul class="nav-links">
        <li><a href="/#product">Product</a></li>
        <li><a href="/#providers">Providers</a></li>
        <li><a href="/#connectors">Connectors</a></li>
      </ul>
      <a class="header-cta" href="/#updates">Join waitlist</a>
    </nav>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <a href="/" class="footer-mark" aria-label="Fable home">
        <img src="/brand/fable-tech-dragon-transparent.png" alt="" />
      </a>
      <nav aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/status">Status</a>
        <a href="/open-source">Open Source</a>
        <a href="https://github.com" rel="noopener" target="_blank">GitHub</a>
      </nav>
      <p>© {year} Fable. Open-source, local-first software.</p>
    </div>
  </footer>
  <script>
    document.documentElement.classList.add('js');
  </script>
</body>
</html>
