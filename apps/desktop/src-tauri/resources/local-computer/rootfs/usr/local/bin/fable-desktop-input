#!/usr/bin/python3
"""Apply one typed native-approved desktop action; never invoke a shell."""
import json
import math
import subprocess
import sys

BUTTONS = {'left': '1', 'middle': '2', 'right': '3'}
KEYS = {'Enter': 'Return', 'Backspace': 'BackSpace', 'ArrowUp': 'Up',
        'ArrowDown': 'Down', 'ArrowLeft': 'Left', 'ArrowRight': 'Right',
        'PageUp': 'Page_Up', 'PageDown': 'Page_Down', ' ': 'space',
        'Tab': 'Tab', 'Escape': 'Escape', 'Delete': 'Delete', 'Home': 'Home',
        'End': 'End', 'Insert': 'Insert', 'BackSpace': 'BackSpace',
        'Page_Up': 'Page_Up', 'Page_Down': 'Page_Down', 'Left': 'Left',
        'Right': 'Right', 'Up': 'Up', 'Down': 'Down'}
MODIFIERS = {'Control': 'ctrl', 'Alt': 'alt', 'Shift': 'shift', 'Meta': 'super'}


def number(value, minimum, maximum):
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
        raise ValueError('Invalid number')
    if not minimum <= value <= maximum:
        raise ValueError('Out of bounds')
    return round(value)


def run(*arguments):
    subprocess.run(arguments, check=True, timeout=2, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


def apply(value):
    kind = value.get('type')
    if kind == 'pointer':
        x = number(value.get('x'), 0, 4095)
        y = number(value.get('y'), 0, 2160)
        action = value.get('action')
        button = BUTTONS[value.get('button', 'left')]
        if action not in ('click', 'down', 'up', 'scroll', 'move'):
            raise ValueError('Unknown pointer action')
        deltas = [(number(value.get(name, 0), -1920, 1920), negative, positive)
                  for name, negative, positive in (('deltaY', 4, 5), ('deltaX', 6, 7))]
        run('xdotool', 'mousemove', '--sync', str(x), str(y))
        if action in ('click', 'down', 'up'):
            run('xdotool', {'click': 'click', 'down': 'mousedown', 'up': 'mouseup'}[action], button)
        elif action == 'scroll':
            for delta, negative, positive in deltas:
                if delta:
                    count = str(min(16, max(1, math.ceil(abs(delta) / 120))))
                    run('xdotool', 'click', '--repeat', count, '--delay', '0', str(negative if delta < 0 else positive))
    elif kind == 'key':
        key = value.get('key')
        modifiers = value.get('modifiers', [])
        action = value.get('action', 'press')
        if not isinstance(key, str) or not isinstance(modifiers, list) or len(modifiers) > 4:
            raise ValueError('Invalid key')
        mapped = KEYS.get(key)
        if mapped is None and key in MODIFIERS:
            mapped = MODIFIERS[key]
        if mapped is None and key.startswith('F') and key[1:].isdigit() and 1 <= int(key[1:]) <= 12:
            mapped = key
        if mapped is None and len(key) == 1 and key.isprintable():
            if not modifiers and action == 'press':
                run('xdotool', 'type', '--clearmodifiers', '--delay', '0', '--', key)
                return
            mapped = key if key.isascii() and key.isalnum() else f'U{ord(key):04X}'
        if mapped is None or action not in ('press', 'down', 'up'):
            raise ValueError('Unsupported key')
        combo = '+'.join([MODIFIERS[item] for item in modifiers] + [mapped])
        command = {'press': 'key', 'down': 'keydown', 'up': 'keyup'}[action]
        run('xdotool', command, combo)
    elif kind == 'text':
        text = value.get('text')
        if not isinstance(text, str) or len(text) > 16384 or '\0' in text:
            raise ValueError('Invalid text')
        run('xdotool', 'type', '--clearmodifiers', '--delay', '0', '--', text)
    elif kind == 'resize':
        width = number(value.get('width'), 640, 3840)
        height = number(value.get('height'), 480, 2160)
        run('xrandr', '--fb', f'{width}x{height}')
    elif kind == 'release':
        # A revoked/disconnected controller must not leave held input behind.
        run('xdotool', 'keyup', 'ctrl', 'alt', 'shift', 'super')
        for button in BUTTONS.values():
            run('xdotool', 'mouseup', button)
    else:
        raise ValueError('Unknown input')


if __name__ == '__main__':
    try:
        apply(json.load(sys.stdin))
    except Exception:
        sys.exit(2)
