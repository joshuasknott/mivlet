#!/usr/bin/python3
"""Install the GUI filesystem policy, then exec one native-selected application."""
import ctypes
import os
from pathlib import Path
import sys

EXECUTE, WRITE, READ, READ_DIR = 1, 2, 4, 8
FILESYSTEM = (1 << 15) - 1
WRITABLE = FILESYSTEM & ~EXECUTE & ~(1 << 6) & ~(1 << 11)
HOME = '/home/fable/.app-home'


class Rules(ctypes.Structure):
    _fields_ = [('fs', ctypes.c_uint64), ('net', ctypes.c_uint64), ('scoped', ctypes.c_uint64)]


class PathRule(ctypes.Structure):
    _pack_ = 1
    _fields_ = [('access', ctypes.c_uint64), ('descriptor', ctypes.c_int32)]


def restrict_filesystem(executable):
    library = ctypes.CDLL(None, use_errno=True)
    library.syscall.restype = ctypes.c_long
    if library.syscall(444, 0, 0, 1) < 6:
        raise RuntimeError('This computer requires Landlock ABI 6 or newer for desktop applications.')
    rules = Rules(FILESYSTEM, 3, 2)  # Deny TCP bind/connect; scope signals to this sandbox.
    descriptor = library.syscall(444, ctypes.byref(rules), ctypes.sizeof(rules), 0)
    if descriptor < 0:
        raise RuntimeError('The desktop application sandbox is unavailable.')

    def allow(path, access):
        resolved = Path(path).resolve(strict=True)
        handle = os.open(resolved, os.O_PATH | os.O_CLOEXEC)
        try:
            if not resolved.is_dir():
                access &= EXECUTE | WRITE | READ | (1 << 14)
            rule = PathRule(access, handle)
            if library.syscall(445, descriptor, 1, ctypes.byref(rule), 0):
                raise RuntimeError('The desktop application sandbox could not be configured.')
        finally:
            os.close(handle)

    try:
        for path in ('/usr/lib', '/usr/share', '/usr/local/lib', '/etc', '/sys/devices/system', '/proc/self'):
            allow(path, READ | READ_DIR)
        for path in ('/proc/cpuinfo', '/proc/meminfo', '/proc/stat', '/proc/filesystems'):
            allow(path, READ)
        for path in (HOME, '/home/fable/Workspace', '/tmp/fable-apps', '/run/fable-gui/runtime'):
            allow(path, WRITABLE)
        # LibreOffice uses a fixed /tmp/OSL_PIPE_* Unix socket regardless of
        # TMPDIR. Permit socket lifecycle only; no general /tmp file reading.
        allow('/tmp', (1 << 9) | (1 << 5))
        for path in ('/dev/null', '/dev/zero', '/dev/urandom', '/dev/random', '/dev/tty', '/dev/pts'):
            allow(path, READ | WRITE | READ_DIR)
        allow(executable, EXECUTE | READ)
        # The trusted preload closes this one-time dynamic-loader allowance
        # before any GUI application code can process an Open With request.
        allow('/lib64/ld-linux-x86-64.so.2', EXECUTE | READ)
        if library.prctl(38, 1, 0, 0, 0) or library.syscall(446, descriptor, 0):
            raise RuntimeError('The desktop application sandbox could not be enforced.')
    finally:
        os.close(descriptor)


def main():
    if os.getuid() != 1002 or len(sys.argv) < 3:
        return 2
    application, ready = sys.argv[1:3]
    if application == 'files' and len(sys.argv) == 3:
        arguments = ['/usr/bin/thunar', '/home/fable/Workspace']
    elif application in ('writer', 'spreadsheet') and len(sys.argv) == 3:
        arguments = ['/usr/lib/libreoffice/program/soffice.bin',
                     '--writer' if application == 'writer' else '--calc',
                     '--norestore', '--nofirststartwizard',
                     '-env:UserInstallation=file://' + HOME + '/libreoffice']
    elif application == 'terminal' and len(sys.argv) == 5:
        descriptor = int(sys.argv[3])
        tty_name = sys.argv[4]
        if descriptor < 3 or descriptor > 1024 or not tty_name.startswith('/dev/pts/') or not tty_name[9:].isdigit():
            return 2
        arguments = ['/usr/bin/xterm', '-T', 'Terminal', '-S' + tty_name + '/' + str(descriptor),
                     '-xrm', 'XTerm*allowWindowOps:false', '-xrm', 'XTerm*allowTitleOps:false',
                     '-xrm', 'XTerm*allowFontOps:false']
    else:
        return 2
    env = {'HOME': HOME, 'USER': 'apps', 'LOGNAME': 'apps', 'LANG': 'C.UTF-8',
           'PATH': '/usr/local/bin:/usr/bin:/bin', 'DISPLAY': ':99',
           'TMPDIR': '/tmp/fable-apps',
           'XDG_RUNTIME_DIR': '/run/fable-gui/runtime', 'GIO_USE_VFS': 'local',
           'DBUS_SESSION_BUS_ADDRESS': 'disabled:', 'NO_AT_BRIDGE': '1',
           'LD_PRELOAD': '/usr/local/lib/fable-gui-exec-guard.so',
           'FABLE_GUI_READY_FD': str(int(ready)), 'SAL_USE_VCLPLUGIN': 'gen'}
    os.chdir('/home/fable/Workspace')
    os.umask(0o007)
    restrict_filesystem(arguments[0])
    os.execve(arguments[0], arguments, env)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception:
        sys.stderr.write('The desktop application could not start in its sandbox.\n')
        raise SystemExit(2)
