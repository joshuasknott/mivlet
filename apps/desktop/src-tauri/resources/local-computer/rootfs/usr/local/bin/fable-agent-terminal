#!/usr/bin/python3
"""Fixed terminal: closed-exec UID1002 xterm and separately supervised UID1001 PTY."""
import os
import re
import select
import signal
import subprocess
import sys
import time


def shell_environment():
    return {'HOME': '/home/agent', 'USER': 'agent', 'LOGNAME': 'agent',
            'PATH': '/usr/local/bin:/usr/bin:/bin', 'LANG': 'C.UTF-8',
            'TMPDIR': '/tmp', 'SHELL': '/bin/bash', 'TERM': 'xterm-256color'}


def drop_command(uid, group, groups):
    return ['/usr/bin/setpriv', f'--reuid={uid}', f'--regid={group}',
            f'--groups={groups}' if groups else '--clear-groups',
            '--no-new-privs', '--inh-caps=-all', '--ambient-caps=-all',
            '--bounding-set=-all']


def valid_window_id(value):
    return re.fullmatch(rb'[0-9a-fA-F]{1,16}\r?\n', value) is not None


def read_ready(descriptor, deadline, maximum=64, newline=False):
    value = b''
    while time.monotonic() < deadline and len(value) < maximum:
        if not select.select([descriptor], [], [], max(0, deadline - time.monotonic()))[0]:
            break
        chunk = os.read(descriptor, 1)
        if not chunk:
            break
        value += chunk
        if not newline or chunk == b'\n':
            return value
    raise RuntimeError('Terminal readiness failed.')


def shell_is_unprivileged(pid):
    try:
        with open(f'/proc/{pid}/status', encoding='ascii') as status:
            fields = dict(line.split(':', 1) for line in status if ':' in line)
        return (fields.get('Uid', '').split() == ['1001'] * 4
                and fields.get('NoNewPrivs', '').strip() == '1'
                and int(fields.get('CapEff', '1').strip(), 16) == 0
                and int(fields.get('CapBnd', '1').strip(), 16) == 0)
    except (OSError, ValueError):
        return False


def monitor(ready, lock):
    import fcntl
    import pty
    import runpy
    import termios
    supervisor = runpy.run_path('/usr/local/bin/fable-agent-shell')
    shell = gui = None
    descriptors = []
    # SIGTERM must run cleanup while the global shell lock is still held.
    def terminate(*_):
        raise SystemExit(2)
    signal.signal(signal.SIGTERM, terminate)
    try:
        os.setsid()
        null = os.open('/dev/null', os.O_RDWR)
        for descriptor in (0, 1, 2):
            os.dup2(null, descriptor)
        if null > 2:
            os.close(null)
        master, slave = pty.openpty()
        descriptors.extend((master, slave))
        os.fchown(slave, 1001, 1001)
        os.fchmod(slave, 0o600)
        original = termios.tcgetattr(slave)
        quiet = termios.tcgetattr(slave)
        quiet[3] &= ~termios.ECHO
        termios.tcsetattr(slave, termios.TCSANOW, quiet)
        guarded, guard_ready = os.pipe()
        descriptors.extend((guarded, guard_ready))
        gui = subprocess.Popen(
            drop_command(1002, 1002, '1001') +
            ['/usr/local/bin/fable-gui-worker', 'terminal', str(guard_ready), str(master), os.ttyname(slave)],
            pass_fds=(guard_ready, master), cwd='/home/fable/Workspace',
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'LANG': 'C.UTF-8'})
        os.close(guard_ready)
        descriptors.remove(guard_ready)
        deadline = time.monotonic() + 5
        if read_ready(guarded, deadline) != b'1':
            raise RuntimeError('GUI execution guard unavailable.')
        # Consume xterm -S's initial window ID before bash exists, so this
        # handshake can never be interpreted as a shell command.
        if not valid_window_id(read_ready(slave, deadline, newline=True)):
            raise RuntimeError('Terminal window did not become ready.')
        termios.tcflush(slave, termios.TCIFLUSH)
        termios.tcsetattr(slave, termios.TCSANOW, original)
        def controlling_terminal():
            os.setsid()
            fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        shell = subprocess.Popen(
            drop_command(1001, 1001, '') + ['/bin/bash', '--noprofile', '--norc', '-i'],
            stdin=slave, stdout=slave, stderr=slave, preexec_fn=controlling_terminal,
            cwd='/home/fable/Workspace', env=shell_environment(), umask=0o007)
        while time.monotonic() < deadline:
            if shell.poll() is not None or gui.poll() is not None:
                raise RuntimeError('Terminal stopped during startup.')
            if shell_is_unprivileged(shell.pid):
                break
            time.sleep(0.01)
        else:
            raise RuntimeError('Unprivileged terminal was not ready.')
        os.write(ready, b'1')
        os.close(ready)
        ready = None
        # Only xterm and bash retain PTY ends, preserving EOF after revocation.
        for descriptor in descriptors:
            os.close(descriptor)
        descriptors.clear()
        while shell.poll() is None and gui.poll() is None:
            time.sleep(0.05)
    finally:
        # No new UID1001 session can start before this cleanup releases flock.
        supervisor['cancel']()
        for child in (shell, gui):
            if child is not None:
                if child.poll() is None:
                    child.terminate()
                try:
                    child.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=2)
        for descriptor in descriptors:
            os.close(descriptor)
        if ready is not None:
            os.close(ready)
        lock.close()


def main():
    import fcntl
    if os.getuid() != 0 or len(sys.argv) != 1:
        return 2
    os.umask(0o077)
    lock = open('/run/fable-private/shell.lock', 'a')
    # Reject queued launches: a root waiter must never spawn after revocation.
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    read_end, ready = os.pipe()
    child = os.fork()
    if child == 0:
        os.close(read_end)
        try:
            monitor(ready, lock)
            os._exit(0)
        except BaseException:
            os._exit(2)
    os.close(ready)
    lock.close()  # The child retains this flock until its complete cleanup.
    try:
        return 0 if read_ready(read_end, time.monotonic() + 6) == b'1' else 2
    except Exception:
        # Stop unacknowledged launchers before reporting a native failure.
        os.kill(child, signal.SIGTERM)
        os.waitpid(child, 0)
        return 2
    finally:
        os.close(read_end)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception:
        sys.exit(2)
