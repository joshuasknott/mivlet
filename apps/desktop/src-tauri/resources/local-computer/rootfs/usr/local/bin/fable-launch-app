#!/bin/bash
set -euo pipefail

export DISPLAY=:99
export HOME=/home/fable

case "${1:-}" in
  browser)
    window="$(xdotool search --onlyvisible --class chromium 2>/dev/null | tail -n 1 || true)"
    if [[ -n "$window" ]]; then
      exec xdotool windowactivate --sync "$window"
    fi
    # The gateway owns the one browser profile and debugging pipe.
    # Starting an unrelated fallback browser would split visible and structured state.
    exit 3
    ;;
  terminal)
    exec sudo -n /usr/local/bin/fable-agent-terminal
    ;;
  files|writer|spreadsheet)
    exec sudo -n /usr/local/bin/fable-gui-launch "$1"
    ;;
  *) exit 2 ;;
esac
