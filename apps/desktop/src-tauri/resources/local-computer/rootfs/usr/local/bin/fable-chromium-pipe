#!/usr/bin/python3
"""Exec Chromium with its private DevTools pipes at descriptors 3 and 4."""
import os
import sys

read_fd, write_fd = map(int, sys.argv[1:3])
# Duplicate both first so fd3/fd4 replacement cannot overwrite either source.
read_copy, write_copy = os.dup(read_fd), os.dup(write_fd)
os.dup2(read_copy, 3, inheritable=True)
os.dup2(write_copy, 4, inheritable=True)
os.set_inheritable(3, True)
os.set_inheritable(4, True)
for descriptor in set((read_fd, write_fd, read_copy, write_copy)) - {3, 4}:
    os.close(descriptor)
os.environ['ACCESSIBILITY_ENABLED'] = '1'
os.execv('/usr/bin/chromium', [
    'chromium', '--remote-debugging-pipe',
    '--disable-background-networking', '--disable-component-update',
    '--disable-features=Translate', '--disable-gpu',
    '--no-default-browser-check', '--no-first-run', '--force-renderer-accessibility=complete',
    '--user-data-dir=/home/fable/.config/chromium-fable',
    '--window-position=0,0', '--window-size=1280,800', 'about:blank',
])
