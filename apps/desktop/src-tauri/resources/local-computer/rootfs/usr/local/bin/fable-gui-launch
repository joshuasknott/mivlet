#!/usr/bin/python3
"""Native-only fixed launcher; acknowledges the GUI only after sandbox setup."""
import os
import select
import subprocess
import sys

if os.getuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ('files', 'writer', 'spreadsheet'):
    raise SystemExit(2)
ready_read, ready_write = os.pipe()
log = open('/run/fable-private/gui.log', 'ab', buffering=0)
child = subprocess.Popen([
    '/usr/bin/setpriv', '--reuid=1002', '--regid=1002', '--groups=1001',
    '--no-new-privs', '--inh-caps=-all', '--ambient-caps=-all', '--bounding-set=-all',
    '/usr/local/bin/fable-gui-worker', sys.argv[1], str(ready_write),
], pass_fds=(ready_write,), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
    start_new_session=True, env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'LANG': 'C.UTF-8'})
os.close(ready_write)
try:
    if not select.select([ready_read], [], [], 5)[0] or os.read(ready_read, 1) != b'1':
        child.kill()
        child.wait()
        raise SystemExit(3)
finally:
    os.close(ready_read)
