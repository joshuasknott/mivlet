#!/bin/bash
set -euo pipefail

export DISPLAY=:99

case "${1:-}" in
  pointer)
    action="${2:-}"
    x="${3:-}"
    y="${4:-}"
    [[ "$x" =~ ^[0-9]{1,4}$ && "$y" =~ ^[0-9]{1,4}$ ]] || exit 2
    xdotool mousemove --sync "$x" "$y"
    case "$action" in
      click)
        xdotool click 1
        ;;
      scroll)
        delta="${5:-0}"
        [[ "$delta" =~ ^-?[0-9]{1,4}$ ]] || exit 2
        magnitude="${delta#-}"
        repeats=$(( (magnitude + 119) / 120 ))
        (( repeats < 1 )) && repeats=1
        (( repeats > 8 )) && repeats=8
        button=5
        (( delta < 0 )) && button=4
        for _ in $(seq 1 "$repeats"); do xdotool click "$button"; done
        ;;
      *) exit 2 ;;
    esac
    ;;
  key)
    value="${2:-}"
    [[ -n "$value" && ${#value} -le 16 ]] || exit 2
    case "$value" in
      Enter) mapped=Return ;;
      Tab|Escape|BackSpace|Delete|Home|End|Page_Up|Page_Down|Left|Right|Up|Down) mapped="$value" ;;
      Backspace) mapped=BackSpace ;;
      ArrowUp) mapped=Up ;;
      ArrowDown) mapped=Down ;;
      ArrowLeft) mapped=Left ;;
      ArrowRight) mapped=Right ;;
      PageUp) mapped=Page_Up ;;
      PageDown) mapped=Page_Down ;;
      ?)
        exec xdotool type --clearmodifiers --delay 0 -- "$value"
        ;;
      *) exit 2 ;;
    esac
    exec xdotool key --clearmodifiers "$mapped"
    ;;
  *) exit 2 ;;
esac
