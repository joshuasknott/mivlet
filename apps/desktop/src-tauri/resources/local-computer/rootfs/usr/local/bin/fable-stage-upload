#!/usr/bin/python3
"""Copy an approved upload into immutable, bounded browser-readable staging."""
import fcntl
import os
from pathlib import Path
import secrets
import shutil
import sys
import time

ROOT = Path('/tmp/fable-uploads')
MAX_FILE = 32 * 1024 * 1024
MAX_TOTAL = 128 * 1024 * 1024


def main():
    if os.getuid() != 0 or len(sys.argv) != 2:
        return 2
    name = sys.argv[1]
    if not name or len(name) > 240 or name in ('.', '..') or any(
            character in '/\\:' or ord(character) < 32 for character in name):
        return 2
    payload = sys.stdin.buffer.read(MAX_FILE + 1)
    if len(payload) > MAX_FILE:
        return 2
    lock = open('/run/fable-private/uploads.lock', 'a')
    fcntl.flock(lock, fcntl.LOCK_EX)
    total = 0
    for directory in ROOT.iterdir():
        if directory.stat().st_mtime < time.time() - 3600:
            shutil.rmtree(directory)
        else:
            total += sum(item.stat().st_size for item in directory.iterdir())
    if total + len(payload) > MAX_TOTAL:
        return 3
    destination = ROOT / secrets.token_hex(16)
    destination.mkdir(mode=0o750)
    os.chown(destination, 0, 1000)
    os.chmod(destination, 0o750)
    target = destination / name
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    with os.fdopen(descriptor, 'wb') as output:
        os.fchown(output.fileno(), 0, 1000)
        os.fchmod(output.fileno(), 0o640)
        output.write(payload)
    print(target)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception:
        sys.stderr.write('The browser upload could not be staged.\n')
        raise SystemExit(2)
