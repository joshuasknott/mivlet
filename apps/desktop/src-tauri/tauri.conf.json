{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arden",
  "version": "0.1.0",
  "identifier": "com.praxis.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arden",
        "label": "main",
        "width": 1440,
        "height": 1024,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
