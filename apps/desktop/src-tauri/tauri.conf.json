{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fable",
  "version": "0.1.0",
  "identifier": "com.fable.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fable",
        "label": "main",
        "width": 1440,
        "height": 1024,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
