{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mivlet",
  "version": "0.1.0",
  "identifier": "com.fable.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mivlet",
        "label": "main",
        "decorations": false,
        "width": 1440,
        "height": 1024,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "windows": {
      "wix": {
        "upgradeCode": "7382634b-7737-5837-ba8c-f1e6cc711f8c"
      },
      "nsis": {
        "template": "windows/installer.nsi"
      }
    },
    "resources": [
      "resources/cua-driver/**/*",
      "resources/agent-host/**/*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Mivlet"
  }
}
