{
  "name": "@fable/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "test": "node --test scripts/local-env.node-test.mjs && vitest run --configLoader runner",
    "test:convex": "vitest run --configLoader runner --dir convex",
    "convex:typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "convex:codegen": "convex codegen --typecheck try",
    "test:csp": "vitest run --configLoader runner src/lib/tauri-csp.test.ts",
    "lint": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs"
  },
  "dependencies": {
    "@fable/connectors": "workspace:*",
    "@fable/knowledge": "workspace:*",
    "@fable/protocol": "workspace:*",
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.9.0",
    "convex": "^1.30.0",
    "marked": "^18.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
