# Google Desktop-app OAuth configuration. Keep real values only in the ignored
# .env.local file; both are consumed by the native credential boundary.
FABLE_GOOGLE_OAUTH_CLIENT_ID=
FABLE_GOOGLE_OAUTH_CLIENT_SECRET=

# Confidential connectors only (GitHub, Vercel, Linear, Notion, Slack).
# Use HTTPS outside local loopback development.
FABLE_AUTH_BROKER_URL=

# Fable account identity (Clerk public-client OAuth + PKCE). Production builds
# fail closed unless issuer, public client id, audience, and authorized party
# are all explicit. Clerk Organizations never define Fable tenancy.
FABLE_CLERK_ISSUER=
FABLE_CLERK_OAUTH_CLIENT_ID=
FABLE_CLERK_AUDIENCE=
FABLE_CLERK_AUTHORIZED_PARTY=
FABLE_CLERK_SCOPES=openid profile email

# Native Convex deployment origin used by the credential-bearing Rust request
# boundary (for example https://example-123.convex.cloud). React never receives
# the Clerk bearer token. VITE_CONVEX_URL remains the public client setting.
FABLE_CONVEX_URL=
VITE_CONVEX_URL=
