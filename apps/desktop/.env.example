# Google Desktop-app OAuth configuration. Keep real values only in the ignored
# .env.local file; both are consumed by the native credential boundary.
MIVLET_GOOGLE_OAUTH_CLIENT_ID=
MIVLET_GOOGLE_OAUTH_CLIENT_SECRET=

# Confidential connectors only (GitHub, Vercel, Linear, Notion, Slack).
# Use HTTPS outside local loopback development.
MIVLET_AUTH_BROKER_URL=

# Mivlet account identity (Clerk public-client OAuth + PKCE). Production builds
# fail closed unless issuer, public client id, and audience are explicit.
# pnpm tauri:build embeds only these public Clerk settings from .env.local.
# Installed apps use them without a development shell. A runtime override must
# supply a complete configuration. Clerk Organizations never define Mivlet tenancy.
MIVLET_CLERK_ISSUER=
MIVLET_CLERK_OAUTH_CLIENT_ID=
MIVLET_CLERK_AUDIENCE=
MIVLET_CLERK_AUTHORIZED_PARTY=
MIVLET_CLERK_SCOPES=openid profile email

# Native Convex deployment origin used by the credential-bearing Rust request
# boundary (for example https://example-123.convex.cloud). React never receives
# the Clerk bearer token. VITE_CONVEX_URL remains the public client setting.
MIVLET_CONVEX_URL=
VITE_CONVEX_URL=
