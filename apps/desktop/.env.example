# Public Google Desktop-app OAuth client id. No client secret belongs here.
FABLE_GOOGLE_OAUTH_CLIENT_ID=

# Confidential connectors only (GitHub, Vercel, Linear, Notion, Slack).
# Use HTTPS outside local loopback development.
FABLE_AUTH_BROKER_URL=

# Optional cloud/team workspace sync. Missing values keep solo local startup
# available and cloud sync disabled.
FABLE_CLERK_ISSUER=
FABLE_CLERK_AUDIENCE=
VITE_CONVEX_URL=
