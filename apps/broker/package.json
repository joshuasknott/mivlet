{
  "name": "@fable/broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mivlet confidential-OAuth auth broker. Deployable, not deployed.",
  "main": "./dist/server.js",
  "bin": {
    "fable-broker": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node ./dist/server.js",
    "worker:dev": "wrangler dev --config wrangler.jsonc --env local --port 8788",
    "worker:dev:staging": "wrangler dev --config wrangler.jsonc --env staging --port 8788",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc --env staging --keep-vars",
    "worker:deploy:dry-run": "wrangler deploy --config wrangler.jsonc --env staging --dry-run --keep-vars",
    "worker:deploy:dry-run:local": "wrangler deploy --config wrangler.jsonc --env local --dry-run",
    "worker:types": "wrangler types --config wrangler.jsonc --env staging",
    "start": "node ./dist/server.js",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@fable/connectors": "workspace:*",
    "@fable/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.105.0"
  }
}
