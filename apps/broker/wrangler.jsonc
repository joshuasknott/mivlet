{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fable-auth-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "FABLE_BROKER_RATE_LIMIT_PER_MINUTE": "60"
  },
  "secrets": {
    "required": [
      "FABLE_BROKER_PUBLIC_URL"
    ]
  }
}
