{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fable-auth-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "FABLE_BROKER_ENVIRONMENT": "local",
    "FABLE_BROKER_RATE_LIMIT_PER_MINUTE": "60",
    // Local/default Worker development keeps memory storage for deterministic tests.
    // Staging and production envs below override this to "durable".
    "FABLE_BROKER_STORAGE_BACKEND": "memory"
  },

  "env": {
    "local": {
      "name": "fable-auth-broker-local",
      "vars": {
        "FABLE_BROKER_ENVIRONMENT": "local",
        "FABLE_BROKER_PUBLIC_URL": "http://127.0.0.1:8788/",
        "FABLE_BROKER_RATE_LIMIT_PER_MINUTE": "60",
        "FABLE_BROKER_STORAGE_BACKEND": "memory"
      }
    },

    "staging": {
      "name": "fable-auth-broker",
      "vars": {
        "FABLE_BROKER_ENVIRONMENT": "staging",
        "FABLE_BROKER_RATE_LIMIT_PER_MINUTE": "60",
        "FABLE_BROKER_STORAGE_BACKEND": "durable"
        // FABLE_BROKER_PUBLIC_URL is environment-specific non-secret config.
        // The live certification broker uses:
        // https://fable-auth-broker.joshhknott.workers.dev/
        // Keep provider callback URLs matched to that origin.
      },
      // Durable Object bindings for pending OAuth exchanges, single-use handoffs,
      // and per-route/peer rate limiting. One DO instance per high-entropy key.
      "durable_objects": {
        "bindings": [
          { "name": "BROKER_PENDING", "class_name": "BrokerPending" },
          { "name": "BROKER_HANDOFF", "class_name": "BrokerHandoff" },
          { "name": "BROKER_RATELIMIT", "class_name": "BrokerRateLimit" }
        ]
      },
      // Migration to introduce the three broker ephemeral DO classes.
      // Applied by the first durable deploy to the live certification Worker;
      // production has the same declaration below.
      "migrations": [
        {
          "tag": "v1-broker-ephemeral",
          "new_sqlite_classes": ["BrokerPending", "BrokerHandoff", "BrokerRateLimit"]
        }
      ]
    },

    "production": {
      "name": "fable-auth-broker-production",
      "vars": {
        "FABLE_BROKER_ENVIRONMENT": "production",
        "FABLE_BROKER_RATE_LIMIT_PER_MINUTE": "60",
        "FABLE_BROKER_STORAGE_BACKEND": "durable"
        // Production is declared for review only in Batch 4. Do not deploy or
        // route traffic until provider certification and the remaining broker
        // security gates are complete.
      },
      // Production is declared but not deployed in Batch 4.
      "durable_objects": {
        "bindings": [
          { "name": "BROKER_PENDING", "class_name": "BrokerPending" },
          { "name": "BROKER_HANDOFF", "class_name": "BrokerHandoff" },
          { "name": "BROKER_RATELIMIT", "class_name": "BrokerRateLimit" }
        ]
      },
      "migrations": [
        {
          "tag": "v1-broker-ephemeral",
          "new_sqlite_classes": ["BrokerPending", "BrokerHandoff", "BrokerRateLimit"]
        }
      ]
    }
  }
}
