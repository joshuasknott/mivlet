# Fable auth broker configuration.
#
# This broker is the ONLY place confidential OAuth client secrets live. Copy this
# file to `.env`, fill in the values from each provider console, and never commit
# the filled-in file. The desktop never sees these values.
#
# Each provider needs a client id + secret created in the provider's developer
# console. See docs/connectors/auth-broker.md for the exact callback URLs and
# scopes to register.

# --- GitHub (GitHub App or OAuth App, confidential client) ---
FABLE_BROKER_GITHUB_CLIENT_ID=
FABLE_BROKER_GITHUB_CLIENT_SECRET=

# --- Vercel (confidential OAuth client) ---
FABLE_BROKER_VERCEL_CLIENT_ID=
FABLE_BROKER_VERCEL_CLIENT_SECRET=

# --- Linear (confidential OAuth client) ---
FABLE_BROKER_LINEAR_CLIENT_ID=
FABLE_BROKER_LINEAR_CLIENT_SECRET=

# --- Notion (internal integration / public integration confidential client) ---
FABLE_BROKER_NOTION_CLIENT_ID=
FABLE_BROKER_NOTION_CLIENT_SECRET=

# --- Slack (confidential OAuth app) ---
FABLE_BROKER_SLACK_CLIENT_ID=
FABLE_BROKER_SLACK_CLIENT_SECRET=

# --- Broker server ---
# Local dev defaults to http://127.0.0.1:8788. Production must sit behind HTTPS.
FABLE_BROKER_PORT=8788
FABLE_BROKER_HOST=127.0.0.1
# Requests per minute per route + peer.
FABLE_BROKER_RATE_LIMIT_PER_MINUTE=60
