# Mivlet auth broker configuration.
#
# This broker is the ONLY place confidential OAuth client secrets live. Copy this
# file to `.env`, fill in the values from each provider console, and never commit
# the filled-in file. The desktop never sees these values.
#
# Each provider needs a client id + secret created in the provider's developer
# console. See docs/product/connectors.md for the authorization boundary and the
# native OAuth scopes the broker requests. The callback for each confidential
# provider is <MIVLET_BROKER_PUBLIC_URL>/oauth/<provider>/callback.
#
# GitHub: register a classic OAuth App (not a GitHub App). The broker requests
# `read:user` and `read:org` only; do not use classic `repo`. Private-repo
# reads are not granted. Vercel: integration read+write so `deployment:write` can
# be granted for native promote/rollback/create/cancel/project/domain actions.
# Linear: `read` and `write` (not create-only scopes). Slack: channel reads plus
# `chat:write` and `reactions:write` for native post/reply/edit/delete/react.
# Notion: public integration; OAuth sends no scope query parameters.

# --- GitHub OAuth App (confidential client) ---
MIVLET_BROKER_GITHUB_CLIENT_ID=
MIVLET_BROKER_GITHUB_CLIENT_SECRET=

# --- Vercel (confidential OAuth client) ---
MIVLET_BROKER_VERCEL_CLIENT_ID=
MIVLET_BROKER_VERCEL_CLIENT_SECRET=

# --- Linear (confidential OAuth client) ---
MIVLET_BROKER_LINEAR_CLIENT_ID=
MIVLET_BROKER_LINEAR_CLIENT_SECRET=

# --- Notion (internal integration / public integration confidential client) ---
MIVLET_BROKER_NOTION_CLIENT_ID=
MIVLET_BROKER_NOTION_CLIENT_SECRET=

# --- Slack (confidential OAuth app) ---
MIVLET_BROKER_SLACK_CLIENT_ID=
MIVLET_BROKER_SLACK_CLIENT_SECRET=

# --- Broker server (local Node.js fallback) ---
# Local dev defaults to http://127.0.0.1:8788. Production must sit behind HTTPS.
MIVLET_BROKER_PORT=8788
MIVLET_BROKER_HOST=127.0.0.1
# Public origin registered in every provider console. Production must be HTTPS.
MIVLET_BROKER_PUBLIC_URL=http://127.0.0.1:8788/
# Optional comma-separated exact HTTPS desktop callbacks. Ephemeral loopback
# http://127.0.0.1:<port>/callback callbacks are allowed by the narrow built-in rule.
MIVLET_BROKER_ALLOWED_DESKTOP_REDIRECTS=
# Requests per minute per route + peer.
MIVLET_BROKER_RATE_LIMIT_PER_MINUTE=60

# Durable/ephemeral storage settings apply to Cloudflare Worker deployments.
# Node dev and ordinary tests use in-memory storage (deterministic, no secret needed).
MIVLET_BROKER_ENVIRONMENT=local
# MIVLET_BROKER_STORAGE_BACKEND=memory
# MIVLET_BROKER_STORE_ENCRYPTION_KEY=   # required only for durable backend; 32-byte base64url secret, never committed
