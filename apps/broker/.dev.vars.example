# Local Cloudflare Worker development bindings.
#
# Copy to `.dev.vars` for `pnpm --filter @fable/broker worker:dev`.
# Do not commit `.dev.vars`; real deployed secrets are set with `wrangler secret put`.

FABLE_BROKER_PUBLIC_URL=http://127.0.0.1:8788/
FABLE_BROKER_RATE_LIMIT_PER_MINUTE=60
FABLE_BROKER_ALLOWED_DESKTOP_REDIRECTS=

# Configure only the providers you are testing locally. Missing provider pairs
# fail closed with configuration-required.
FABLE_BROKER_GITHUB_CLIENT_ID=
FABLE_BROKER_GITHUB_CLIENT_SECRET=
FABLE_BROKER_VERCEL_CLIENT_ID=
FABLE_BROKER_VERCEL_CLIENT_SECRET=
FABLE_BROKER_LINEAR_CLIENT_ID=
FABLE_BROKER_LINEAR_CLIENT_SECRET=
FABLE_BROKER_NOTION_CLIENT_ID=
FABLE_BROKER_NOTION_CLIENT_SECRET=
FABLE_BROKER_SLACK_CLIENT_ID=
FABLE_BROKER_SLACK_CLIENT_SECRET=

# --- Durable Object broker storage (ephemeral OAuth state) ---
# Default is memory (see wrangler.jsonc). Set to "durable" only for Worker dev with real bindings.
# FABLE_BROKER_STORE_ENCRYPTION_KEY is REQUIRED when backend=durable (32-byte base64url secret).
# Generate once locally for .dev.vars only; never commit real value. For prod: wrangler secret put.
# FABLE_BROKER_STORAGE_BACKEND=memory
# FABLE_BROKER_STORE_ENCRYPTION_KEY=
